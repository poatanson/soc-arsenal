# 복사해서 .env 로 저장한 뒤 키를 채우세요:  cp .env.example .env
# 키가 없는 제공자는 자동으로 건너뜁니다. .env 는 절대 커밋하지 마세요.

# https://www.virustotal.com/gui/my-apikey  (무료: 4회/분, 500회/일)
VT_API_KEY=

# https://www.abuseipdb.com/account/api  (무료: 1,000회/일)
ABUSEIPDB_API_KEY=

# https://urlscan.io/user/profile/  (검색 API)
URLSCAN_API_KEY=

# 선택: 캐시 위치/유효시간(초)
# SOC_ARSENAL_CACHE=~/.cache/soc-arsenal
# SOC_ARSENAL_CACHE_TTL=86400
